{
  "font": {
    "family": {
      "space-grotesk": { "$type": "fontFamily", "$value": "\"Space Grotesk\", sans-serif" },
      "eb-garamond": { "$type": "fontFamily", "$value": "\"EB Garamond\", serif" },
      "jost": { "$type": "fontFamily", "$value": "Jost" },
      "display": { "$type": "fontFamily", "$value": "{font.family.space-grotesk}" },
      "utility": { "$type": "fontFamily", "$value": "{font.family.space-grotesk}" },
      "editorial": { "$type": "fontFamily", "$value": "{font.family.eb-garamond}" },
      "identity": { "$type": "fontFamily", "$value": "{font.family.jost}" }
    },
    "dependency": {
      "space-grotesk": { "$type": "fontFamily", "$value": "@fontsource-variable/space-grotesk" },
      "eb-garamond": { "$type": "fontFamily", "$value": "@fontsource-variable/eb-garamond" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "type": {
    "size": {
      "utility": { "$type": "dimension", "$value": "12px" },
      "label": { "$type": "dimension", "$value": "14px" },
      "ui": { "$type": "dimension", "$value": "16px" },
      "body": { "$type": "dimension", "$value": "18px" },
      "lead": { "$type": "dimension", "$value": "20px" },
      "heading-small": { "$type": "dimension", "$value": "24px" },
      "heading-medium": { "$type": "dimension", "$value": "32px" },
      "heading-large": { "$type": "dimension", "$value": "40px" },
      "display": { "$type": "dimension", "$value": "48px" }
    },
    "line-height": {
      "tight": { "$type": "number", "$value": 1.1 },
      "ui": { "$type": "number", "$value": 1.3 },
      "body": { "$type": "number", "$value": 1.55 },
      "editorial": { "$type": "number", "$value": 1.6 }
    },
    "letter-spacing": {
      "utility": { "$type": "dimension", "$value": "0.08em" },
      "normal": { "$type": "dimension", "$value": "0em" }
    }
  }
}
